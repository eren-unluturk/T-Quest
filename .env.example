# Copy to .env (gitignored). Never commit real values.
# Tiger Data (Tiger Cloud) Postgres + TimescaleDB connection string
DATABASE_URL=postgresql://tsdbadmin:CHANGE_ME@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
# Local docker-compose fallback:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tquest
MBTA_API_KEY=
# Service ports
DATA_PLATFORM_PORT=8001
INSIGHTS_SPONSORS_PORT=8002
GAME_ENGINE_PORT=8003
# Shared secret for store-verification endpoint (game-engine)
REDEMPTION_SIGNING_SECRET=
# NEVER add an Anthropic API key or token here or anywhere. Everyone uses their own Claude plan, never per-token billing.

# --- OPTIONAL production mode / future public hosting (see docs/FUTURE_PUBLIC_HOSTING.md). Values are set on the HOST, never committed. ---
# dev (default): plain username bearer tokens. prod: signed short-lived tokens only, exact CORS origins required.
APP_ENV=
# prod only: at least 16 random characters; shared by all three services. Rotate after the event.
TOKEN_SECRET=
# prod only: exact front-end origin(s), comma-separated, no wildcard
CORS_ORIGINS=
# Separate demo database used by future-hosting/scripts/seed-demo-db.mjs (must differ from DATABASE_URL)
DEMO_DATABASE_URL=
# Front end (Vercel/Vite) base URLs
VITE_DATA_PLATFORM_URL=
VITE_INSIGHTS_URL=
VITE_GAME_URL=

#!/usr/bin/env node
// Strips attribution lines (any Co-Authored-By, Claude-Session, "Generated with", noreply@anthropic.com,
// robot-emoji lines) from the commit message. Aborts if nothing is left.
const { readFileSync, writeFileSync } = require('node:fs');
const { stripBanned } = require('./attribution.cjs');

const file = process.argv[2];
if (!file) process.exit(0);
const original = readFileSync(file, 'utf8');
const cleaned = stripBanned(original);
if (cleaned !== original) writeFileSync(file, cleaned);
if (!cleaned.replace(/^#.*$/gm, '').trim()) {
  console.error('commit-msg: message is empty after removing attribution lines. Write a plain message and retry.');
  process.exit(1);
}
